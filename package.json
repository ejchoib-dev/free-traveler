{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format:check": "python scripts/check_format.py",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:public": "playwright test --project=chromium tests/e2e/public-smoke.spec.ts",
    "task:contract": "python scripts/audit_tasks.py",
    "screen:contract": "python scripts/check_screen_contract.py",
    "validate": "python scripts/validate_inputs.py && npm run task:contract && python scripts/build_waves.py && npm run screen:contract",
    "ci": "npm run lint && npm run typecheck && npm run test:unit && npm run task:contract && npm run screen:contract && npm run build",
    "release:check": "npm run ci && python scripts/run_release_smoke.py"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
